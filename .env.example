# ─────────────────────────────────────────────────────────────────────────────
# ZYVENTA — environment layout
#
#   apps/api/.env        ← API secrets & config      (template: apps/api/.env.example)
#   apps/web/.env.local  ← web public config          (template: apps/web/.env.example)
#   .env (this file)     ← only for `docker compose --profile app` build arguments
#
# Secrets (JWT, Razorpay secret, Cloudinary secret, SMTP password …) go ONLY in apps/api/.env.
# ─────────────────────────────────────────────────────────────────────────────

# Public values baked into the web image at build time (browser-visible — no secrets).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=
