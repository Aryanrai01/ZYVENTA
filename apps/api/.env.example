# ─────────────────────────────────────────────────────────────────────────────
# ZYVENTA API — copy to apps/api/.env and fill in. Never commit the real .env.
# Variables marked (Phase N) are not read yet; they become required in that phase.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
# APP_ENV selects the deployment environment and Razorpay key mode.
# Render demo: NODE_ENV=production and APP_ENV=staging (Razorpay test keys).
# Real production: NODE_ENV=production and APP_ENV=production (Razorpay live keys).
APP_ENV=development
PORT=4000
LOG_LEVEL=info
# pretty (default in development) | json (default otherwise)
LOG_FORMAT=
APP_VERSION=0.1.0

# Browser origins allowed to call the API with cookies (comma-separated, no trailing slash).
CORS_ORIGINS=http://localhost:3000
# Reverse proxies in front of the API in production (0 locally).
TRUST_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=300

# MongoDB MUST be a replica set (transactions). Local docker-compose value shown;
# for Atlas use your mongodb+srv:// connection string.
MONGODB_URI=mongodb://localhost:27017/zyventa?replicaSet=rs0&directConnection=true

# ── Development data (Phase 3) ── password for all `pnpm db:seed` demo accounts
SEED_USER_PASSWORD=
# Only for non-interactive `pnpm create-admin` (CI/containers); prefer the hidden prompt.
ADMIN_PASSWORD=

# ── Auth (Phase 4) ── REQUIRED. Generate EACH with: openssl rand -base64 64  (must differ)
# Signs access-token JWTs.
JWT_ACCESS_SECRET=
# HMAC key for hashing refresh / email / reset tokens and signing CSRF tokens.
# (Refresh tokens are opaque random values, not JWTs, so no separate refresh JWT secret.)
TOKEN_HASH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Parent domain for auth cookies in production, e.g. .zyventa.com (leave empty locally).
COOKIE_DOMAIN=
# Public URL of the web app (used in email links).
WEB_APP_URL=http://localhost:3000
# (Phase 7) 32-byte key (base64) for encrypting seller payout details: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# ── Email (Phase 4) ── local dev uses Mailpit from docker-compose (UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="ZYVENTA <no-reply@zyventa.local>"

# ── Cloudinary (Phase 5) ── https://console.cloudinary.com → Settings → API Keys
# Optional in development (image uploads return 503 until set). Set all three or none.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=zyventa

# ── Razorpay (Phase 8) ── TEST keys in development/staging; LIVE keys in production.
# Local development: NODE_ENV=development, APP_ENV=development, RAZORPAY_KEY_ID=rzp_test_...
# Render staging: NODE_ENV=production, APP_ENV=staging, RAZORPAY_KEY_ID=rzp_test_...
# Real production: NODE_ENV=production, APP_ENV=production, RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret you set when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# ── Background jobs ── set false if you run jobs in a separate worker process
JOBS_ENABLED=true
