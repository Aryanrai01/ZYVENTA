# ─────────────────────────────────────────────────────────────────────────────
# ZYVENTA web — copy to apps/web/.env.local and fill in.
# NEXT_PUBLIC_* values are embedded in browser JavaScript: NEVER put a secret here.
# ─────────────────────────────────────────────────────────────────────────────

# Public API base URL used by the browser (and by the server unless API_INTERNAL_URL is set).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Canonical site URL for SEO metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Razorpay PUBLIC key id only (Phase 8). The key secret lives in the API .env, never here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Server-side only: API URL reachable from the Next.js server (Docker: http://api:4000/api/v1).
API_INTERNAL_URL=
